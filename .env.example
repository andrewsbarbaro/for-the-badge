# For the Badge - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Session & Security
# =============================================================================

# Session password for nuxt-auth-utils (generate a random 32+ char string)
NUXT_SESSION_PASSWORD=your-secure-session-password-here

# Password pepper for additional password hashing security (base64 encoded)
PASSWORD_PEPPER=your-base64-encoded-pepper

# HMAC secret for account operations (base64 encoded)
ACCOUNT_HMAC_SECRET=your-base64-encoded-hmac-secret

# Encryption key for badge data (base64 encoded, 32 bytes)
BADGE_ENCRYPTION_KEY=your-base64-encoded-encryption-key

# Alphabet for generating short referral IDs (58 unique characters)
REFERRAL_SQIDS_ALPHABET=your-58-char-unique-alphabet

# =============================================================================
# STRIPE PAYMENTS (required for homepage pixel purchases)
# =============================================================================

# Stripe secret key (sk_live_... or sk_test_... for development)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe publishable key (pk_live_... or pk_test_... for development)
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Stripe webhook signing secret (get this from Stripe dashboard > Webhooks)
# Local dev: run `yarn stripe` to get a temporary secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Stripe product ID for the Badge Board pixel space (create once in Stripe dashboard)
STRIPE_PRODUCT_ID=prod_your-product-id

# Cloudflare Analytics API (for live visitor stats on the homepage)
# Token needs Zone Analytics:Read permission — create at dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cf-api-token
# Zone ID found in the Overview tab of your domain in Cloudflare dashboard
CLOUDFLARE_ZONE_ID=your-cf-zone-id

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# For local HTTPS development, generate certificates:
# openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
